.tab-row {
  display: flex;
  gap: 56rpx;
  margin: -24rpx -32rpx 24rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #E5E7EB;
  background: #FFFFFF;
}

.tab {
  padding: 22rpx 0;
  color: #374151;
  position: relative;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.2rpx;
}

.tab.active {
  color: #155DFC;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #155DFC;
}

.goal-card {
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  padding: 28rpx;
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goal-ops {
  display: flex;
  gap: 18rpx;
}

.goal-title {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: 0.2rpx;
}

.goal-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.goal-desc {
  margin-top: 10rpx;
  color: #6D7A92;
  font-size: 28rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30rpx 0 16rpx;
  color: #4B5563;
  font-size: 26rpx;
}

.progress-text {
  color: #155DFC;
}

.progress-wrap {
  margin: 0 0 20rpx;
  height: 12rpx;
  border-radius: 10rpx;
  background: #E5E7EB;
}

.progress-inner {
  height: 100%;
  border-radius: inherit;
  background: #2563EB;
}

.meta-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goal-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.action-btn {
  min-width: 112rpx;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
  color: #FFFFFF;
  background: #155DFC;
}

.action-btn.ghost {
  color: #155DFC;
  border: 1rpx solid #155DFC;
  background: #FFFFFF;
}

.check-days {
  color: #374151;
  font-size: 26rpx;
  line-height: 1.25;
}

.date-text {
  color: #9CA3AF;
  font-size: 20rpx;
  line-height: 1.25;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 92rpx;
  height: 92rpx;
  text-align: center;
  line-height: 80rpx;
  background: #4C6FFF;
  color: #FFFFFF;
  border-radius: 46rpx;
  font-size: 56rpx;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.35);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 42rpx;
  color: #7A879C;
}

.form-item {
  margin-bottom: 18rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #0F172A;
  margin-bottom: 10rpx;
}

.form-input,
.form-textarea {
  background: #F3F4F6;
  border-radius: 14rpx;
  padding: 16rpx;
  color: #374151;
  min-height: 40rpx;
  box-sizing: border-box;
}

.form-input-title {
  min-height: 72rpx;
  line-height: 40rpx;
}

.form-input-date {
  min-height: 40rpx;
}

.form-textarea {
  height: 156rpx;
  line-height: 38rpx;
  width: 100%;
}

.date-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.date-item {
  flex: 1;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.btn-ghost {
  border: 1rpx solid #D1D5DB;
  color: #1F2937;
  background: #FFFFFF;
}

.btn-primary {
  background: #050521;
  color: #FFFFFF;
}
