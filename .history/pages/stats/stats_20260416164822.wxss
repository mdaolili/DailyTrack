.stats-page {
  background: #F3F4F6;
  min-height: 100vh;
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(26rpx + constant(safe-area-inset-bottom));
}

.top-header {
  margin: -24px -32rpx 24rpx;
  padding: 0 32rpx;
  height: 98rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E7EB;
}

.top-title {
  font-size: 40rpx;
  font-weight: 500;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.overview-card {
  border-radius: 28rpx;
  border: 1rpx solid #E7E9EE;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  padding: 22rpx 22rpx 20rpx;
}

.overview-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 24rpx;
}

.icon-orange {
  background: #FDE9D4;
}

.icon-blue {
  background: #DCEBFF;
}

.icon-green {
  background: #D6F5DF;
}

.icon-purple {
  background: #ECDDFF;
}

.overview-label {
  font-size: 28rpx;
  color: #4B5565;
  line-height: 1.25;
}

.overview-value {
  margin-top: 16rpx;
  display: block;
  font-size: 46rpx;
  line-height: 1.1;
  font-weight: 500;
  color: #0F172A;
}

.overview-unit {
  margin-top: 6rpx;
  display: block;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.25;
}

.section-card {
  margin-top: 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid #E7E9EE;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  padding: 30rpx;
}

.goal-ring-wrap {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.goal-ring {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 14rpx solid #D7E5FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-center {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.goal-ring-percent {
  font-size: 52rpx;
  font-weight: 500;
  color: #0F172A;
  line-height: 1;
}

.goal-ring-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.goal-rate-track {
  margin: 22rpx auto 0;
  width: 72%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #E5E7EB;
}

.goal-rate-fill {
  height: 100%;
  border-radius: inherit;
  background: #2563EB;
}

.heatmap-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(15, 1fr);
  gap: 12rpx 10rpx;
}

.heatmap-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.heat-level-0 {
  background: #ECEEF2;
}

.heat-level-1 {
  background: #CFF5DF;
}

.heat-level-2 {
  background: #5BE794;
}

.heat-level-3 {
  background: #12BF58;
}

.legend-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-label {
  font-size: 28rpx;
  color: #6B7280;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
}

.trend-chart {
  margin-top: 16rpx;
  height: 420rpx;
  display: flex;
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-tabs {
  display: flex;
  gap: 10rpx;
}

.trend-tab {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #D1D5DB;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.2;
}

.trend-tab.active {
  color: #155DFC;
  border-color: #155DFC;
  background: #EEF4FF;
}

.trend-caption {
  margin-top: 10rpx;
  display: block;
  color: #94A3B8;
  font-size: 24rpx;
}

.y-axis {
  width: 46rpx;
  padding-bottom: 52rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
}

.y-label {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1;
}

.chart-panel {
  flex: 1;
  margin-left: 14rpx;
}

.chart-body {
  position: relative;
  height: 338rpx;
  box-sizing: border-box;
  border-left: 2rpx solid #CBD5E1;
  border-bottom: 2rpx solid #CBD5E1;
}

.grid-line {
  height: 25%;
  border-top: 1rpx dashed #EEF2F7;
  box-sizing: border-box;
}

.bars-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.bar-value {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1;
}

.bar-track {
  width: 36rpx;
  height: calc(100% - 54rpx);
  border-radius: 18rpx;
  background: #F1F5F9;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  min-height: 0;
  border-radius: 18rpx 18rpx 0 0;
  background: linear-gradient(180deg, #5EA1FF 0%, #1D5EEB 100%);
}

.bar-empty-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #CBD5E1;
  margin-bottom: 8rpx;
}

.x-label-row {
  height: 52rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.x-label {
  flex: 1;
  text-align: center;
  color: #475569;
  font-size: 30rpx;
  line-height: 1;
}

.rank-card {
  margin-bottom: 30rpx;
}

.rank-list {
  margin-top: 16rpx;
}

.rank-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.rank-click-mask {
  position: absolute;
  inset: 0;
}

.rank-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-1 {
  background: #F9F1CC;
  color: #A67A00;
}

.rank-2 {
  background: #ECEFF3;
}

.rank-3 {
  background: #F8EBDD;
  color: #986640;
}

.rank-main {
  flex: 1;
}

.rank-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.rank-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-percent {
  font-size: 34rpx;
  font-weight: 400;
  color: #4B5563;
  line-height: 1.2;
}

.rank-progress {
  margin-top: 10rpx;
  width: 100%;
  height: 12rpx;
  border-radius: 12rpx;
  background: #ECEFF3;
}

.rank-progress-inner {
  height: 100%;
  border-radius: 12rpx;
  background: #3B82F6;
}

.empty-tip {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}
