.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 500;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4A5565;
  font-size: 34rpx;
}

.preview-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 500;
}

.preview-text {
  color: #4A5565;
  font-size: 30rpx;
}

.preview-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.todo-preview {
  display: flex;
  align-items: center;
}

.todo-circle {
  color: #9CA3AF;
  margin-right: 8rpx;
  font-size: 30rpx;
}

.todo-circle.checked {
  color: #155DFC;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: #4C6FFF;
  color: #FFFFFF;
  font-size: 58rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(76, 111, 255, 0.35);
}
