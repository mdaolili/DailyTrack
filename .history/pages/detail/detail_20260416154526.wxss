.page {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-bar {
  margin: 0 -32rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E7EB;
  box-sizing: border-box;
}

.top-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.top-side {
  width: 64rpx;
  text-align: center;
  font-size: 44rpx;
  color: #0F172A;
}

.top-center {
  flex: 1;
  text-align: center;
}

.date-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #0F172A;
  line-height: 42rpx;
}

.date-week {
  font-size: 24rpx;
  color: #6B7280;
}

.section-header {
  display: flex;
  justify-content: space-between;
  color: #101828;
  margin-bottom: 12rpx;
  align-items: center;
}

.fold-btn {
  color: #0A0A0A;
  font-size: 34rpx;
}

.add-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.task-input {
  flex: 1;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 14rpx 18rpx 14rpx 22rpx;
}

.add-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #155DFC;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 40rpx;
}

.diary-card {
  margin-top: 24rpx;
  min-height: 720rpx;
}

.title-input {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
  color: #99A1AF;
}

.content-input {
  width: 100%;
  min-height: 340rpx;
  margin-bottom: 26rpx;
  color: #99A1AF;
}

.mood-label {
  color: #4A5565;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.mood-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.mood {
  width: 100rpx;
  height: 90rpx;
  border-radius: 20rpx;
  border: 1rpx solid #E5E7EB;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.mood.active {
  border-color: #155DFC;
  background: #F2F6FF;
}

.mood-icon {
  font-size: 32rpx;
  line-height: 1;
}

.mood-text {
  margin-top: 2rpx;
  color: #4A5565;
  font-size: 24rpx;
}

.image-label {
  margin-top: 2rpx;
}

.image-picker-wrap {
  display: block;
  margin-top: 12rpx;
}

.save-tip {
  display: block;
  color: #8B96AA;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.bottom-delete {
  margin: 36rpx auto calc(24rpx + env(safe-area-inset-bottom));
  margin: 36rpx auto calc(24rpx + constant(safe-area-inset-bottom));
  padding: 0 36rpx;
  width: fit-content;
  border-radius: 16rpx;
  border: 1rpx solid #F2C3C3;
  background: #FFF7F7;
  color: #C4232A;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  line-height: 56rpx;
}

.export-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1200rpx;
  opacity: 0;
  pointer-events: none;
}
