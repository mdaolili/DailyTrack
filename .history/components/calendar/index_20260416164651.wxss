.calendar-wrap {
  background: #F9FAFB;
}

.month-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.switch-btn {
  width: 44rpx;
  height: 44rpx;
  text-align: center;
  line-height: 44rpx;
  color: #0A0A0A;
  font-size: 36rpx;
}

.month-label {
  font-size: 36rpx;
  font-weight: 500;
  color: #0A0A0A;
}

.week-row,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.week-item {
  text-align: center;
  color: #6A7282;
  font-size: 26rpx;
  margin-bottom: 4rpx;
}

.day-cell {
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 98rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}

.today {
  background: #155DFC;
  color: #FFFFFF;
}

.other {
  opacity: 0.35;
}

.day-text {
  font-size: 32rpx;
}

.today .day-text {
  color: #FFFFFF;
}

.day-label {
  max-width: 84rpx;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.1;
  color: #EF4444;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.today .day-label {
  color: #E9EEFF;
}

.marks {
  position: absolute;
  right: 8rpx;
  bottom: 6rpx;
  line-height: 1;
}

.mark-diary {
  color: #A020F0;
  font-size: 18rpx;
}

.mark-check {
  color: #155DFC;
  font-size: 14rpx;
}

.mark-pending {
  color: #F97316;
  font-size: 18rpx;
}

.today .marks text {
  color: #FFFFFF;
}
