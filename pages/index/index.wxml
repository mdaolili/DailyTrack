<view class="page">
  <view class="header">
    <text class="title">日历日记</text>
    <view class="header-actions">
      <view class="icon-btn" bindtap="goSearch">
        <image class="search-icon" src="/images/icon/search.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <calendar-view
    currentMonth="{{currentMonth}}"
    days="{{calendarDays}}"
    bind:changemonth="handleChangeMonth"
    bind:selectday="handleSelectDay"
    bind:longpressday="handleLongPressDay"
  />

  <view class="card preview-card" bindtap="goTodayDetail">
    <view class="preview-row">
      <text class="preview-title">今日 · {{todayMMDD}}</text>
    </view>
    <view class="preview-bottom">
      <view class="todo-preview">
        <text class="todo-circle {{todayHasDone ? 'checked' : ''}}">◯</text>
        <text class="preview-text">今日待办 {{todayTodoCount}} 项</text>
      </view>
      <view class="diary-preview">
        <image class="diary-icon" src="/images/icon/edit.png" mode="aspectFit" />
        <text class="preview-text">{{todayDiaryText}}</text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goTodayDetail">+</view>
</view>
