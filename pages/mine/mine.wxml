<view class="page">
  <view class="card user-card">
    <view class="avatar">时</view>
    <view>
      <text class="name">{{profile.nickname}}</text>
      <text class="desc">坚持记录每一天</text>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="key" data-key="{{item.key}}" bindtap="handleMenuTap">
      <view class="menu-left">
        <text>{{item.label}}</text>
        <text class="menu-desc" wx:if="{{item.key === 'lock'}}">{{settings.diaryLockEnabled ? '已开启' : '未开启'}}</text>
        <text class="menu-desc" wx:if="{{item.key === 'theme'}}">{{settings.theme === 'light' ? '浅色' : '深色'}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <text class="version">时光记 v1.0.0</text>
</view>
