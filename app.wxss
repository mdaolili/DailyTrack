page {
  background: #F9FAFB;
  color: #1E2430;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1E2430;
}
